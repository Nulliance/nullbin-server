(* A chat with a password. The attacker runs the server, holds the room key
   and Alice's invite link (it leaked before she used it), but not the
   password, which was sent another way. Run with
     proverif -lib proverif/room proverif/password.pv *)

free pw: bitstring [private].

(* G3: even with Alice's link, the attacker is never admitted in her place
   (or anyone's): every admitted key is an honest joiner's. *)
query k: pkey, b: bpkey; event(Admitted(s1, k, b)) ==> event(Joining(s1, k, b)).
query k: pkey, b: bpkey; event(Admitted(s2, k, b)) ==> event(Joining(s2, k, b)).
query r: bitstring, k: pkey, b: bpkey; event(AcceptMember(r, s1, k)) ==> event(Joining(s1, k, b)).

(* G2 *)
query r: bitstring, t: bitstring; event(Received(r, s1, t)) ==> event(Sent(s1, r, t)).

(* G1, G4 and G6. *)
query attacker(secretMsg).
query attacker(roster).
(* The password itself stays secret from the server and the link holder. *)
query attacker(pw).

(* Not a goal, and expected "false": with a used link (its secret) and the
   join made with it, the password can be guessed offline, one Argon2id per
   guess (THREAT_MODEL.md R25). Only a strong password protects it. *)
weaksecret pw.

(* Sanity: the honest run happens ("false", with a trace). *)
query event(Received(s2, s1, secretMsg)).
query k: pkey, b: bpkey; event(Admitted(s1, k, b)).

process
  new sk0: skey;
  new is1: bitstring;
  new is2: bitstring;
  out(c, spk(sk0));
  out(c, is1);
  ( Admit(sk0, s1, v2, (is1, pwKey(pw))) | Admit(sk0, s2, v2, (is2, pwKey(pw)))
  | Member(s1, v2, (is1, pwKey(pw)), spk(sk0)) | Member(s2, v2, (is2, pwKey(pw)), spk(sk0)) )
