#!/usr/bin/env bash
# Reads cached data only. Called by PAM's MOTD hook (or a login profile).
# Never source the cache or show arbitrary API response text in a terminal.
set -euo pipefail
export LC_ALL=C

config=${1:-/etc/nullbin-update-check.conf}
cache=${2:-/var/lib/nullbin-update-check}
# The cache belongs to the unprivileged checker: read it only if it is a
# small regular file (not a link, FIFO or device), and only its first bytes.
[[ -r $config && -f $cache/latest && ! -L $cache/latest ]] || exit 0
[[ $(stat -c %s -- "$cache/latest" 2>/dev/null || echo 99) -le 64 ]] || exit 0
{
  IFS= read -r _repository
  IFS= read -r installed
} < "$config" || exit 0
# (The file could be swapped after the check: give up after a second.)
latest=$(timeout 1 head -c 65 -- "$cache/latest" 2>/dev/null | head -n 1) || exit 0
stable='^v(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$'
[[ ${#installed} -le 64 && ${#latest} -le 64 && $installed =~ $stable && $latest =~ $stable ]] || exit 0
[[ $latest != "$installed" ]] || exit 0
[[ $(printf '%s\n' "$installed" "$latest" | sort -V | tail -n 1) == "$latest" ]] || exit 0

printf '\nNullbin update available: %s (installed: %s).\n' "$latest" "$installed"
printf 'Run sudo ./nullbin update from your Nullbin deploy directory.\n\n'
