(* The attacker runs the server, holds the room key and has place 3's
   invite link, so it is an admitted member itself. Run with
     proverif -lib proverif/room proverif/member.pv *)

(* G3: only the honest joiners' keys are admitted for places 1 and 2, and
   a tab takes no other keys as theirs. *)
query k: pkey, b: bpkey; event(Admitted(s1, k, b)) ==> event(Joining(s1, k, b)).
query k: pkey, b: bpkey; event(Admitted(s2, k, b)) ==> event(Joining(s2, k, b)).
query r: bitstring, k: pkey, b: bpkey; event(AcceptMember(r, s1, k)) ==> event(Joining(s1, k, b)).
query r: bitstring, k: pkey, b: bpkey; event(AcceptMember(r, s2, k)) ==> event(Joining(s2, k, b)).

(* G2: a message read as Alice's (or Bob's) was sent by them, to that reader. *)
query r: bitstring, t: bitstring; event(Received(r, s1, t)) ==> event(Sent(s1, r, t)).
query r: bitstring, t: bitstring; event(Received(r, s2, t)) ==> event(Sent(s2, r, t)).

(* G1 and G4: Alice's message to Bob stays secret from the attacker, a
   member itself, even after Bob's device is taken (phase 1). *)
query attacker(secretMsg).

(* Sanity: the honest run happens. ProVerif must answer "false" here, with
   a trace: Bob reads Alice's message, and both are admitted. A "true"
   would mean the model never gets that far, and the results above prove
   nothing. *)
query event(Received(s2, s1, secretMsg)).
query k: pkey, b: bpkey; event(Admitted(s2, k, b)).

process
  new sk0: skey;
  new is1: bitstring;
  new is2: bitstring;
  new is3: bitstring;
  out(c, spk(sk0));
  out(c, is3);
  ( Admit(sk0, s1, v1, is1) | Admit(sk0, s2, v1, is2) | Admit(sk0, s3, v1, is3)
  | Member(s1, v1, is1, spk(sk0)) | Member(s2, v1, is2, spk(sk0)) )
